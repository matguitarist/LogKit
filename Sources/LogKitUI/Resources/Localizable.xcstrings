    "Messages appear here as they're logged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen erscheinen hier, sobald sie protokolliert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes aparecen aquí a medida que se registran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages apparaissent ici à mesure qu’ils sont journalisés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens aparecem aqui conforme são registradas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息记录后会显示在这里。"
          }
        }
